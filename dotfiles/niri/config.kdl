// ~/.config/niri/config.kdl
//
// Split into modules mirroring ~/.config/hypr/lua/, so the two compositor
// configs read side by side.
//
// Includes are top-level only and positional: settings and window rules land
// at the point of the `include` line, so order matters.

include "monitors.kdl"  // outputs
include "layout.kdl"    // layout, overview, blur, cursor
include "input.kdl"     // input, gestures
include "rules.kdl"     // window and layer rules
include "binds.kdl"     // keybinds
include "autostart.kdl" // environment, spawn-at-startup

// Ask clients to drop client-side decorations and tell them they are tiled.
// Restart apps for a change here to take effect.
prefer-no-csd

// strftime(3). Same format the Hyprland session passes to hyprshot.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 0.5
}

hotkey-overlay {
    skip-at-startup

    // Otherwise the overlay lists important actions even when nothing is
    // bound to them, advertising binds this config does not have.
    hide-not-bound
}

clipboard {
    // No middle-click paste.
    disable-primary
}
